ELF ?=
TRACE ?= 64
TEST ?=
LIB ?=

GUEST_TEST_ROOT := guest-tests/src
GUEST_TEST_DIR := $(GUEST_TEST_ROOT)/$(TEST)
GUEST_ARTIFACT_DIR := guest-tests/artifacts
GUEST_ARTIFACT := $(GUEST_ARTIFACT_DIR)/$(TEST).gen5.elf

POWERSHELL ?= pwsh.exe


# ============================================================
# Validation
# ============================================================

.PHONY: check-test

check-test:
	@if [ -z "$(TEST)" ]; then \
		echo "ERROR: TEST is required"; \
		echo ""; \
		echo "Example:"; \
		echo "  make run TEST=hle-pad"; \
		exit 1; \
	fi
	@if [ ! -d "$(GUEST_TEST_DIR)" ]; then \
		echo "ERROR: guest test not found:"; \
		echo "  $(GUEST_TEST_DIR)"; \
		exit 1; \
	fi


# ============================================================
# Create guest test
# ============================================================

.PHONY: guest-new

guest-new:
	@if [ -z "$(TEST)" ]; then \
		echo "ERROR: TEST is required"; \
		echo ""; \
		echo "Example:"; \
		echo "  make guest-new TEST=hle-pad LIB=ScePad"; \
		exit 1; \
	fi
	@if [ -d "$(GUEST_TEST_DIR)" ]; then \
		echo "ERROR: guest test already exists:"; \
		echo "  $(GUEST_TEST_DIR)"; \
		exit 1; \
	fi
	@mkdir -p "$(GUEST_TEST_DIR)"
	@printf '%s\n' \
		'#include <stdint.h>' \
		'' \
		'int main(void)' \
		'{' \
		'    return 0;' \
		'}' \
		> "$(GUEST_TEST_DIR)/main.c"
	@if [ -n "$(LIB)" ]; then \
		printf '%s\n' \
			'LDLIBS := \' \
			'  -l$(LIB)' \
			'' \
			'include ../../common.mk' \
			> "$(GUEST_TEST_DIR)/Makefile"; \
	else \
		printf '%s\n' \
			'include ../../common.mk' \
			> "$(GUEST_TEST_DIR)/Makefile"; \
	fi
	@echo ""
	@echo "========================================"
	@echo " VirtualPS5 guest test created"
	@echo "========================================"
	@echo " Test:     $(TEST)"
	@if [ -n "$(LIB)" ]; then echo " Library:  lib$(LIB)"; fi
	@echo " Path:     $(GUEST_TEST_DIR)"
	@echo ""
	@echo " Files:"
	@echo "   $(GUEST_TEST_DIR)/main.c"
	@echo "   $(GUEST_TEST_DIR)/Makefile"
	@echo ""
	@echo "Next:"
	@echo "  make run TEST=$(TEST)"
	@echo "========================================"


# ============================================================
# Guest build
# ============================================================

.PHONY: guest guest-build guest-clean guest-inspect

guest: check-test
	$(MAKE) -C "$(GUEST_TEST_DIR)" clean all inspect

guest-build: check-test
	$(MAKE) -C "$(GUEST_TEST_DIR)" all

guest-clean: check-test
	$(MAKE) -C "$(GUEST_TEST_DIR)" clean

guest-inspect: check-test
	$(MAKE) -C "$(GUEST_TEST_DIR)" inspect


# ============================================================
# Windows host
# ============================================================

.PHONY: host-build

host-build:
	@WIN_REPO="$$(wslpath -w "$(CURDIR)")"; \
	$(POWERSHELL) -NoProfile -Command \
		"Set-Location '$$WIN_REPO'; dotnet build"


# ============================================================
# Run already-built guest
# ============================================================

.PHONY: guest-run

guest-run: check-test
	@if [ ! -f "$(GUEST_ARTIFACT)" ]; then \
		echo "ERROR: guest artifact not found:"; \
		echo "  $(GUEST_ARTIFACT)"; \
		echo ""; \
		echo "Build it first:"; \
		echo "  make guest TEST=$(TEST)"; \
		exit 1; \
	fi
	@WIN_REPO="$$(wslpath -w "$(CURDIR)")"; \
	WIN_ELF="$$(wslpath -w "$(CURDIR)/$(GUEST_ARTIFACT)")"; \
	$(POWERSHELL) -NoProfile -Command \
		"Set-Location '$$WIN_REPO'; dotnet run --project '.\src\SharpEmu.CLI\SharpEmu.CLI.csproj' -- --cpu-engine=native --log-level=debug --trace-imports 16 '$$WIN_ELF'"


# ============================================================
# Full development loop
# ============================================================

.PHONY: run

run: check-test host-build guest
	@WIN_REPO="$$(wslpath -w "$(CURDIR)")"; \
	WIN_ELF="$$(wslpath -w "$(CURDIR)/$(GUEST_ARTIFACT)")"; \
	$(POWERSHELL) -NoProfile -Command \
		"Set-Location '$$WIN_REPO'; dotnet run --project '.\src\SharpEmu.CLI\SharpEmu.CLI.csproj' -- --cpu-engine=native --log-level=debug --trace-imports 16 '$$WIN_ELF'"



# ============================================================
# Real PS5 executable
# ============================================================

.PHONY: check-real real-inspect real-run

check-real:
	@if [ -z "$(ELF)" ]; then \
		echo "ERROR: ELF is required"; \
		echo ""; \
		echo "Example:"; \
		echo "  make real-run ELF=/mnt/e/PS5/MyGame/eboot.bin"; \
		exit 1; \
	fi
	@if [ ! -f "$(ELF)" ]; then \
		echo "ERROR: executable not found:"; \
		echo "  $(ELF)"; \
		exit 1; \
	fi

real-inspect: check-real
	@echo ""
	@echo "========================================"
	@echo " VirtualPS5 real executable"
	@echo "========================================"
	@echo " File: $(ELF)"
	@echo ""
	@file "$(ELF)" || true
	@echo ""
	@if head -c 4 "$(ELF)" | grep -q "$$(printf '\177ELF')"; then \
		echo "=== ELF HEADER ==="; \
		llvm-readelf-18 -h "$(ELF)" || true; \
		echo ""; \
		echo "=== NEEDED LIBRARIES ==="; \
		llvm-readelf-18 -d "$(ELF)" | grep NEEDED || true; \
		echo ""; \
		echo "=== UNDEFINED SYMBOLS ==="; \
		llvm-readelf-18 -Ws "$(ELF)" | grep UND || true; \
	else \
		echo "Not a raw ELF; skipping llvm-readelf inspection."; \
		echo "SharpEmu will inspect/load the container itself."; \
	fi
	@echo "========================================"

real-run: check-real host-build
	@WIN_REPO="$$(wslpath -w "$(CURDIR)")"; \
	WIN_ELF="$$(wslpath -w "$(ELF)")"; \
	echo ""; \
	echo "========================================"; \
	echo " VirtualPS5 real executable run"; \
	echo "========================================"; \
	echo " Executable: $(ELF)"; \
	echo " Trace:      $(TRACE) imports"; \
	echo "========================================"; \
	echo ""; \
	$(POWERSHELL) -NoProfile -Command \
		"Set-Location '$$WIN_REPO'; dotnet run --project '.\src\SharpEmu.CLI\SharpEmu.CLI.csproj' -- --cpu-engine=native --log-level=debug --trace-imports $(TRACE) '$$WIN_ELF'"


