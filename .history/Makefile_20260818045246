TEST ?=

GUEST_TEST_ROOT := guest-tests/src
GUEST_TEST_DIR := $(GUEST_TEST_ROOT)/$(TEST)

.PHONY: guest guest-build guest-clean guest-inspect check-test

check-test:
	@if [ -z "$(TEST)" ]; then \
		echo "ERROR: TEST is required"; \
		echo "Example: make guest TEST=hle-kernel-clock"; \
		exit 1; \
	fi
	@if [ ! -d "$(GUEST_TEST_DIR)" ]; then \
		echo "ERROR: guest test not found: $(GUEST_TEST_DIR)"; \
		exit 1; \
	fi

guest: check-test
	$(MAKE) -C $(GUEST_TEST_DIR) clean all inspect

guest-build: check-test
	$(MAKE) -C $(GUEST_TEST_DIR) all

guest-clean: check-test
	$(MAKE) -C $(GUEST_TEST_DIR) clean

guest-inspect: check-test
	$(MAKE) -C $(GUEST_TEST_DIR) inspect

POWERSHELL ?= pwsh.exe

.PHONY: guest-run host-build run

host-build:
	$(POWERSHELL) -NoProfile -Command "Set-Location '$$(wslpath -w '$(CURDIR)')'; dotnet build"

guest-run: check-test
	@WIN_REPO="$$(wslpath -w "$(CURDIR)")"; \
	WIN_ELF="$$(wslpath -w "$(CURDIR)/guest-tests/artifacts/$(TEST).gen5.elf")"; \
	$(POWERSHELL) -NoProfile -Command "Set-Location '$$WIN_REPO'; dotnet run --project '.\src\SharpEmu.CLI\SharpEmu.CLI.csproj' -- --cpu-engine=native --log-level=debug --trace-imports 16 '$$WIN_ELF'"

run: host-build guest
	@WIN_REPO="$$(wslpath -w "$(CURDIR)")"; \
	WIN_ELF="$$(wslpath -w "$(CURDIR)/guest-tests/artifacts/$(TEST).gen5.elf")"; \
	$(POWERSHELL) -NoProfile -Command "Set-Location '$$WIN_REPO'; dotnet run --project '.\src\SharpEmu.CLI\SharpEmu.CLI.csproj' -- --cpu-engine=native --log-level=debug --trace-imports 16 '$$WIN_ELF'"