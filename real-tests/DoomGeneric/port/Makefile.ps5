# VirtualPS5 application build for DoomGeneric.
#
# Uses the ps5-payload-sdk purely as a cross-toolchain and ABI/header reference;
# the application is entered through the VirtualPS5 CRT (our crt0), not the
# payload runtime. libc/sce* symbols become NID imports resolved by VirtualPS5 HLE.
#
# Invoke from the doomgeneric source directory:
#   make -f Makefile.ps5 VPS5=/home/illia/projects/virtualps5

PS5_PAYLOAD_SDK ?= /opt/ps5-payload-sdk
VPS5            ?= /home/illia/projects/virtualps5

CC        := $(PS5_PAYLOAD_SDK)/bin/prospero-clang
CRT0      := $(VPS5)/guest-tests/runtime/crt0.S
MARK_GEN5 := $(VPS5)/guest-tests/tools/mark-gen5.py
PORT      := $(VPS5)/real-tests/DoomGeneric/port/doomgeneric_ps5.c

OUTDIR    := $(VPS5)/real-tests/DoomGeneric
BUILDDIR  := build-ps5
ELF       := $(BUILDDIR)/doomgeneric.elf
EBOOT     := $(OUTDIR)/eboot.bin

# DoomGeneric core (the canonical source list, minus the xlib backend which the
# PS5 port replaces).
DOOM_SRC := \
  dummy.c am_map.c doomdef.c doomstat.c dstrings.c d_event.c d_items.c d_iwad.c \
  d_loop.c d_main.c d_mode.c d_net.c f_finale.c f_wipe.c g_game.c hu_lib.c \
  hu_stuff.c info.c i_cdmus.c i_endoom.c i_joystick.c i_scale.c i_sound.c \
  i_system.c i_timer.c memio.c m_argv.c m_bbox.c m_cheat.c m_config.c \
  m_controls.c m_fixed.c m_menu.c m_misc.c m_random.c p_ceilng.c p_doors.c \
  p_enemy.c p_floor.c p_inter.c p_lights.c p_map.c p_maputl.c p_mobj.c p_plats.c \
  p_pspr.c p_saveg.c p_setup.c p_sight.c p_spec.c p_switch.c p_telept.c p_tick.c \
  p_user.c r_bsp.c r_data.c r_draw.c r_main.c r_plane.c r_segs.c r_sky.c \
  r_things.c sha1.c sounds.c statdump.c st_lib.c st_stuff.c s_sound.c tables.c \
  v_video.c wi_stuff.c w_checksum.c w_file.c w_main.c w_wad.c z_zone.c \
  w_file_stdc.c i_input.c i_video.c doomgeneric.c

OBJS := $(addprefix $(BUILDDIR)/, $(DOOM_SRC:.c=.o)) \
        $(BUILDDIR)/doomgeneric_ps5.o $(BUILDDIR)/crt0.o

# Doom is old C: relax warnings, disable strict aliasing, define the platform.
CFLAGS := -O2 -g -std=gnu11 -fno-strict-aliasing -fwrapv \
  -Wno-everything -DNORMALUNIX -DLINUX -D_DEFAULT_SOURCE \
  -I. -I$(VPS5)/real-tests/DoomGeneric/port

# Our CRT entry, no payload startup files. libc/sce imports stay dynamic (NID).
LDFLAGS := -nostartfiles -Wl,-e,_start
LDLIBS  := -lScePad -lSceVideoOut -lSceUserService -lkernel -lSceLibcInternal -lc

.PHONY: all clean
all: $(EBOOT)

$(BUILDDIR):
	mkdir -p $(BUILDDIR)

$(BUILDDIR)/%.o: %.c | $(BUILDDIR)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILDDIR)/doomgeneric_ps5.o: $(PORT) | $(BUILDDIR)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILDDIR)/crt0.o: $(CRT0) | $(BUILDDIR)
	$(CC) $(CFLAGS) -c -o $@ $<

$(ELF): $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)

$(EBOOT): $(ELF)
	mkdir -p $(OUTDIR)
	python3 $(MARK_GEN5) $(ELF) $(EBOOT)
	@echo "=== built $(EBOOT) ==="

clean:
	rm -rf $(BUILDDIR)
